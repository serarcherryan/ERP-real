{
  "name": "erp-real",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "bash scripts/start-dev.sh",
    "start:dev": "bash scripts/start-dev.sh",
    "start:web": "bash scripts/start-web.sh",
    "start:backend": "bash scripts/start-backend-dev.sh",
    "start:backend:docker": "bash scripts/start-backend-docker.sh",
    "test:scripts": "node --test scripts/start-scripts.test.mjs",
    "test:backend": "cd apps/backend && mvn test",
    "build:backend": "cd apps/backend && mvn package",
    "dev:web": "npm run dev -w @erp-real/web-admin -- --host 0.0.0.0",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build -w @erp-real/web-admin",
    "test": "npm run test --workspaces --if-present",
    "test:web": "npm run test -w @erp-real/web-admin",
    "test:shared": "npm run test -w @erp-real/shared-domain"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
